{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/guard-destructive.sh\"",
            "timeout": 30,
            "statusMessage": "Checking for destructive commands"
          }
        ]
      }
    ]
  }
}
